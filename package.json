{
  "name": "distributed-task-execution",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @task-engine/shared && npm run build -w @task-engine/server && npm run build -w @task-engine/web",
    "dev:api": "npm run dev:api -w @task-engine/server",
    "dev:worker": "npm run dev:worker -w @task-engine/server",
    "dev:web": "npm run dev -w @task-engine/web",
    "test": "npm run test -w @task-engine/server",
    "seed": "npm run seed -w @task-engine/server",
    "lint": "eslint .",
    "up": "docker compose up --build",
    "down": "docker compose down -v",
    "typecheck": "npm run typecheck -w @task-engine/shared && npm run typecheck -w @task-engine/server && npm run typecheck -w @task-engine/web",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript-eslint": "^8.70.0"
  }
}

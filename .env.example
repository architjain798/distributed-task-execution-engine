# docker-compose reads this file automatically if you copy it to .env.
# Every value has a working default, so `docker compose up` needs none of them.

WEB_PORT=8080
API_PORT=3000

MYSQL_PASSWORD=root
MYSQL_DATABASE=task_engine

# Worker threads in the pool. Also the concurrency limit: one task per thread.
WORKER_COUNT=4

# Per-client submission limit.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# Seeding and the deliberate worker kill. Disable to run without them.
ENABLE_DEV_ROUTES=true

LOG_LEVEL=info
